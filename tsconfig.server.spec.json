{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./out-tsc/spec",
    "tsBuildInfoFile": "./out-tsc/spec/tsconfig.server.spec.tsbuildinfo",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/server/**/*.spec.ts",
    "src/server/**/*.d.ts",
    "src/server/test/**/*.ts"
  ],
  "exclude": []
}
