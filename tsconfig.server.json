{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // Type imports must say `type`, so swc strips them instead of emitting a dead runtime binding.
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src/server",
    "customConditions": ["orchard-src"],
    "incremental": true,
    // Pinned: rootDir sits below the config file, which otherwise pushes this outside the repo.
    "tsBuildInfoFile": "./dist/tsconfig.server.tsbuildinfo",
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
  },
  "include": ["src/server"],
  "exclude": ["src/server/**/*.spec.ts", "src/server/test/**"]
}