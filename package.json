{
  "name": "orchard",
  "version": "1.11.0",
  "description": "Web application for Cashu mint management",
  "author": "shyguy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "imports": {
    "#server/*": {
      "orchard-src": "./src/server/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "NODE_ENV=production npm run generate:types && NODE_ENV=production nest build && NODE_ENV=production ng build",
    "format": "prettier --write \"src/client/**/*.{ts,html}\" \"src/client/modules/**/*.scss\" \"src/server/**/*.ts\"",
    "format:watch": "nodemon --watch src/client --watch src/server --ext ts,html,scss,json --exec \"npm run format\"",
    "format:check": "prettier --check \"src/client/**/*.{ts,html}\" \"src/client/modules/**/*.scss\" \"src/server/**/*.ts\"",
    "ng": "ng",
    "start": "NODE_ENV=production node ./scripts/generate-runtime-config.mjs && NODE_ENV=production node dist/main.js",
    "start:client": "NODE_ENV=development node ./scripts/generate-runtime-config.mjs && NODE_ENV=development npx graphql-codegen && NODE_ENV=development ng serve --proxy-config proxy.conf.cjs",
    "start:server": "NODE_ENV=development nest start --watch",
    "start:server:nowatch": "NODE_ENV=development nest start",
    "start:server:debug": "NODE_ENV=development nest start --debug --watch",
    "generate:types": "SCHEMA_ONLY=true node --conditions=orchard-src --import ./scripts/register.mjs scripts/generate-schema.ts && npx graphql-codegen",
    "typecheck:spec": "tsc -p tsconfig.server.spec.json --noEmit",
    "ci": "npm run format:check && npm run lint && npm run typecheck:spec && npm run generate:types && npm run test && npm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:server:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:server:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:server:e2e": "./e2e/supertest/scripts/run.sh",
    "test:client": "ng test --watch=false --browsers=ChromeHeadless --progress=false",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "watch:client": "NODE_ENV=development ng build --watch --configuration development",
    "migration:generate": "NODE_ENV=development node --conditions=orchard-src --import ./scripts/register.mjs node_modules/typeorm/cli.js migration:generate -d src/server/database/data-source.ts",
    "migration:run": "NODE_ENV=development node --conditions=orchard-src --import ./scripts/register.mjs node_modules/typeorm/cli.js migration:run -d src/server/database/data-source.ts",
    "migration:revert": "NODE_ENV=development node --conditions=orchard-src --import ./scripts/register.mjs node_modules/typeorm/cli.js migration:revert -d src/server/database/data-source.ts",
    "migration:show": "NODE_ENV=development node --conditions=orchard-src --import ./scripts/register.mjs node_modules/typeorm/cli.js migration:show -d src/server/database/data-source.ts",
    "e2e:up": "./e2e/docker/scripts/compose.sh up",
    "e2e:down": "./e2e/docker/scripts/compose.sh down",
    "e2e:logs": "./e2e/docker/scripts/compose.sh logs",
    "e2e:ps": "./e2e/docker/scripts/compose.sh ps",
    "e2e:sim:up": "./e2e/docker/scripts/compose.sh activity start",
    "e2e:sim:down": "./e2e/docker/scripts/compose.sh activity stop",
    "e2e:sim:status": "./e2e/docker/scripts/compose.sh activity status",
    "e2e:sim:logs": "./e2e/docker/scripts/compose.sh activity logs",
    "e2e:bootstrap-mainchain": "./e2e/docker/scripts/bootstrap-mainchain.sh",
    "e2e:test": "npx playwright test --config=./e2e/playwright.config.ts",
    "e2e:test:ai": "npx playwright test --config=./e2e/playwright.ai.config.ts"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/material-luxon-adapter": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "13.2.4",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "13.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "compression": "^1.8.1",
    "grammy": "^1.46.0",
    "graphql": "^16.13.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.8",
    "luxon": "^3.7.2",
    "marked": "^17.0.5",
    "ng2-charts": "^10.0.0",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "qr-code-styling": "^1.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socks-proxy-agent": "^8.0.5",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^14.0.2",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-tools/schema": "^10.0.38",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.27",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.13.10",
    "@types/node-fetch": "^2.6.13",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jasmine-core": "~6.1.0",
    "jest": "~30.4.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src/server",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "<rootDir>/test/jest-esm-globals.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.server.spec.json",
          "useESM": true
        }
      ]
    },
    "testEnvironmentOptions": {
      "customExportConditions": [
        "orchard-src",
        "node",
        "node-addons",
        "require",
        "default"
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "@apollo/server-plugin-landing-page-graphql-playground": {
      "@apollo/server": "^5.0.0"
    }
  }
}
